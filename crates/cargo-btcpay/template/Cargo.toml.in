[package]
name = "{{crate_name}}"
version = "0.1.0"
edition = "2021"
description = "{{description}}"

[lib]
crate-type = ["cdylib"]
# Every btcpay-rs plugin builds under this name, not the crate's own. The generated C#
# binds to it, which is what lets one set of bindings serve every plugin. Plugins stay
# isolated: each loads in its own context, from its own directory.
name = "btcpay_plugin_native"

[dependencies]
btcpay-plugin = "0.1"

[profile.release]
lto = true
# Must stay false. The binding generator reads metadata from the library's symbols and,
# when stripped, exits successfully having produced nothing. Stripping happens at packaging
# time instead, once the bindings exist.
strip = false
