<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <RootNamespace>BtcpayRs.Host.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../BtcpayRs.Host/BtcpayRs.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real Rust library from examples/hello-plugin: these tests exercise the actual
         FFI boundary, not a mock of it. -->
    <None Include="../../target/release/libbtcpay_plugin_native.so"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
